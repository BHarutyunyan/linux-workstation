#!/bin/sh
# Keep the battery from sitting at 100%, which wears it out fastest.
# Runs as root at every boot (battery-threshold.service). Each laptop gets
# what its firmware can do:
#   ThinkPad (E16):       stop at CHARGE_END, start again below CHARGE_START
#   IdeaPad/Legion (Y520): only an on/off "conservation mode" (holds ~60%)
# UPower may later write its own numbers over ours (it did: 75/80 on the E16).

set -u
START="${CHARGE_START:-70}"
END="${CHARGE_END:-80}"
CONSERVATION="${CHARGE_CONSERVATION:-1}"

set_thresholds() {
	bat="$1"
	# The kernel refuses start >= end. Writing start, end, start again works
	# whether the new range is above or below the old one.
	if [ -w "$bat/charge_control_start_threshold" ]; then
		echo "$START" > "$bat/charge_control_start_threshold" 2>/dev/null
	fi
	echo "$END" > "$bat/charge_control_end_threshold" || return 1
	if [ -w "$bat/charge_control_start_threshold" ]; then
		echo "$START" > "$bat/charge_control_start_threshold" || return 1
	fi
	echo "$(basename "$bat"): charge $(cat "$bat/charge_control_start_threshold" 2>/dev/null || echo -)-$(cat "$bat/charge_control_end_threshold")%"
}

found=0
for bat in /sys/class/power_supply/BAT*; do
	[ -d "$bat" ] || continue
	found=1
	if [ -w "$bat/charge_control_end_threshold" ]; then
		set_thresholds "$bat" || echo "$(basename "$bat"): could not set thresholds" >&2
		exit 0
	fi
done
[ "$found" = 1 ] || { echo "no battery: nothing to do"; exit 0; }

# No thresholds: try the IdeaPad/Legion conservation mode.
for mode in /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode; do
	[ -w "$mode" ] || continue
	# On/off only: 1 holds the battery near 60%, good for a laptop that lives
	# on the charger (the Legion test bench); 0 charges to 100% for trips.
	echo "$CONSERVATION" > "$mode" || { echo "could not set conservation mode" >&2; exit 0; }
	echo "conservation mode: $(cat "$mode") (1 = holds about 60%)"
	exit 0
done

echo "battery has no charge limit this script knows: left at 100%"
